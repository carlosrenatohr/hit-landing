---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { servicePages, getServicePage } from '../../content/servicePages';
import { waUrlForPath } from '../../lib/whatsapp';

export function getStaticPaths() {
  return servicePages.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const wa = waUrlForPath(Astro.url.pathname);
---

<Layout title={service.title} description={service.metaDescription}>
  <section class="pt-32 pb-16 bg-secondary">
    <div class="container mx-auto px-4 md:px-6 text-center">
      <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Servicios', href: '/servicios' }, { label: service.nav }]} />
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4">{service.title}</h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto">{service.hero}</p>
    </div>
  </section>

  <section class="py-16 bg-neutral-bg dark:bg-secondary">
    <div class="container mx-auto px-4 md:px-6 max-w-4xl">
      <p class="text-lg text-neutral-text dark:text-gray-300 mb-12">{service.intro}</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        {service.bullets.map((b) => (
          <div class="bg-white dark:bg-secondary-light p-6 rounded-lg shadow-lg border border-primary/10 flex flex-col">
            <h3 class="font-bold text-lg text-secondary dark:text-white mb-2">{b.title}</h3>
            <p class="text-neutral-text dark:text-gray-300 mb-4">{b.text}</p>
            {b.cta && (
              <a href={b.cta.href} class="mt-auto text-primary font-semibold hover:underline">
                {b.cta.label}
              </a>
            )}
          </div>
        ))}
      </div>

      <h2 class="text-2xl font-bold text-secondary dark:text-white mb-6">Cómo funciona</h2>
      <ol class="space-y-4 mb-16">
        {service.steps.map((step, i) => (
          <li class="flex items-start">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-primary text-navy font-bold flex items-center justify-center mr-4">{i + 1}</span>
            <span class="text-neutral-text dark:text-gray-300 pt-1">{step}</span>
          </li>
        ))}
      </ol>

      <div class="bg-secondary-light dark:bg-secondary-light rounded-lg p-8 text-center">
        <p class="text-lg text-gray-200 mb-6">{service.closing}</p>
        <a href={wa} target="_blank" rel="noopener" class="inline-block bg-primary text-navy py-3 px-8 rounded-md font-bold hover:bg-primary-dark transition-all">
          Escribinos por WhatsApp
        </a>
      </div>

      {/* Related services */}
      <nav aria-label="Otros servicios" class="mt-16 pt-8 border-t border-primary/10">
        <p class="text-sm font-semibold uppercase tracking-wide text-neutral-text dark:text-gray-400 text-center mb-4">Otros servicios</p>
        <div class="flex flex-wrap justify-center gap-3">
          {servicePages
            .filter((s) => s.slug !== service.slug)
            .map((s) => (
              <a
                href={`/servicios/${s.slug}`}
                class="px-4 py-2 rounded-full bg-white dark:bg-secondary-light border border-primary/20 text-sm font-medium text-secondary dark:text-white hover:border-primary/60 hover:text-primary transition-all"
              >
                {s.nav}
              </a>
            ))}
        </div>
      </nav>
    </div>
  </section>
</Layout>
