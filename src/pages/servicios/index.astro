---
import Layout from '../../layouts/Layout.astro';
import { servicePages } from '../../content/servicePages';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { WA_MESSAGES, waUrl } from '../../lib/whatsapp';

const wa = waUrl(WA_MESSAGES.servicesIndex);

// Service cards organized in 2 visual groups
const mainServices = ['aereo', 'maritimo', 'encomiendas'];
const commercialServices = ['importacion-china', 'importacion-panama', 'importacion-usa', 'importacion-global'];

const getService = (slug) => servicePages.find(s => s.slug === slug);
---

<Layout
  title="Todos los Servicios"
  description="Servicios de importación a Nicaragua: carga aérea, marítima, encomiendas e importación comercial desde China, Panamá, USA y cualquier parte del mundo."
>
  <section class="pt-32 pb-16 bg-secondary">
    <div class="container mx-auto px-4 md:px-6 text-center">
      <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Servicios' }]} />
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4">Todos los Servicios</h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto">
        Importá desde USA, China, Panamá y cualquier parte del mundo a Nicaragua.
      </p>
    </div>
  </section>

  <section class="py-16 bg-neutral-bg dark:bg-secondary">
    <div class="container mx-auto px-4 md:px-6 max-w-5xl">
      {/* Group 1: Main Services + Pricing */}
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-secondary dark:text-white mb-2 text-center">Servicios Principales desde Estados Unidos</h2>
        <p class="text-neutral-text dark:text-gray-300 text-center mb-8">Paquetería y encomiendas para compras personales</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {mainServices.map((slug) => {
            const service = getService(slug);
            return (
              <a
                href={`/servicios/${slug}`}
                class="block bg-white dark:bg-secondary-light p-8 rounded-lg shadow-lg border border-primary/10 hover:border-primary/40 transition-all"
              >
                <h3 class="text-xl font-bold text-secondary dark:text-white mb-3">{service.nav}</h3>
                <p class="text-neutral-text dark:text-gray-300 mb-4">{service.hero}</p>
                <span class="text-primary font-medium">Ver más →</span>
              </a>
            );
          })}
          <a
            href="/precios"
            class="block bg-primary/5 dark:bg-primary/10 p-8 rounded-lg shadow-lg border-2 border-primary/30 hover:border-primary/60 transition-all"
          >
            <h3 class="text-xl font-bold text-secondary dark:text-white mb-3">Precios y Tarifas</h3>
            <p class="text-neutral-text dark:text-gray-300 mb-4">Conocé nuestras tarifas: aéreo $6.50/libra, marítimo $2.50/libra. Entrega nacional incluida.</p>
            <span class="text-primary font-medium">Ver precios →</span>
          </a>
        </div>
      </div>

      {/* Group 2: Commercial Import Services */}
      <div>
        <h2 class="text-2xl font-bold text-secondary dark:text-white mb-2 text-center">Importación Comercial</h2>
        <p class="text-neutral-text dark:text-gray-300 text-center mb-8">Para negocios y cargas comerciales de cualquier origen</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {commercialServices.map((slug) => {
            const service = getService(slug);
            return (
              <a
                href={`/servicios/${slug}`}
                class="block bg-white dark:bg-secondary-light p-6 rounded-lg shadow-lg border border-navy/10 hover:border-primary/40 transition-all"
              >
                <h3 class="text-lg font-bold text-secondary dark:text-white mb-2">{service.nav}</h3>
                <p class="text-sm text-neutral-text dark:text-gray-300 mb-3">{service.hero}</p>
                <span class="text-primary font-medium text-sm">Ver más →</span>
              </a>
            );
          })}
        </div>
      </div>

      <div class="text-center mt-16">
        <p class="text-lg text-neutral-text dark:text-gray-300 mb-6">
          ¿No estás seguro de cuál te conviene? Te asesoramos sin compromiso.
        </p>
        <a href={wa} target="_blank" rel="noopener" data-wa-location="services_index" class="inline-block bg-primary text-navy py-3 px-8 rounded-md font-bold hover:bg-primary-dark transition-all">
          Escribinos por WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>
