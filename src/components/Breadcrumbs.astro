---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm">
    {items.map((item, i) => (
      <li class="flex items-center gap-x-2">
        {i > 0 && <span class="text-gray-500" aria-hidden="true">/</span>}
        {item.href ? (
          <a href={item.href} class="text-gray-400 hover:text-primary transition-colors">
            {item.label}
          </a>
        ) : (
          <span class="text-gray-200">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
